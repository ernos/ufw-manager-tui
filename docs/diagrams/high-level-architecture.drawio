<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="high-level-architecture" name="High-Level Architecture">
    <mxGraphModel dx="1520" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="ufw-manager-tui - System Context (C4 Level 1)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A Rust terminal UI that reads and writes the system firewall only through the ufw CLI" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="800" height="26" as="geometry" />
        </mxCell>

        <mxCell id="host" value="Linux host (Ubuntu / Debian family)" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f8f8f8;strokeColor=#999999;dashed=1;fontStyle=1;fontSize=14;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1230" height="620" as="geometry" />
        </mxCell>

        <mxCell id="actor" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;new Linux user or admin,&lt;br&gt;local TTY or SSH session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;arcSize=6;" vertex="1" parent="host">
          <mxGeometry x="30" y="215" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="system" value="&lt;b&gt;ufw-manager-tui&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Rust binary + library crate&lt;br&gt;&lt;br&gt;ui/ - ratatui rendering&lt;br&gt;app.rs - state and change pipeline&lt;br&gt;core/ - pure logic, no I/O&lt;br&gt;backend/ - all OS access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=6;shadow=1;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="290" y="180" width="270" height="170" as="geometry" />
        </mxCell>

        <mxCell id="ufw" value="&lt;b&gt;ufw&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;command line interface&lt;br&gt;ufw 0.36+&lt;br&gt;/usr/sbin/ufw&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=6;" vertex="1" parent="host">
          <mxGeometry x="680" y="205" width="160" height="110" as="geometry" />
        </mxCell>

        <mxCell id="kernel" value="&lt;b&gt;netfilter / nftables&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linux kernel packet filter&lt;br&gt;ufw-user-input / ufw-user-output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=6;" vertex="1" parent="host">
          <mxGeometry x="960" y="195" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="config" value="&lt;b&gt;Config and undo state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;~/.config/ufw-manager-tui/config.toml&lt;br&gt;~/.local/state/ufw-manager-tui/journal.json&lt;br&gt;watchdog.json and watchdog.json.cancel&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="40" y="470" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="etcufw" value="&lt;b&gt;ufw configuration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/etc/ufw/ufw.conf - on/off, log level&lt;br&gt;/etc/ufw/applications.d/* - app profiles&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="340" y="470" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="logs" value="&lt;b&gt;Kernel and ufw log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/var/log/ufw.log&lt;br&gt;fallback: journalctl -k -f&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="host">
          <mxGeometry x="680" y="470" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="probes" value="&lt;b&gt;Host probes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nft -j list ruleset - hit counters&lt;br&gt;ss -tulpn - listening sockets&lt;br&gt;ip route / ip addr - LAN&lt;br&gt;sshd_config - SSH port&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="host">
