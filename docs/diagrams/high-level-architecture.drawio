        <mxCell id="legend" value="Legend: blue = the system documented here; grey = external executables and the kernel; yellow cylinders = local files, logs and probe sources read by the TUI. Unlabelled arrows are file and probe reads." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
