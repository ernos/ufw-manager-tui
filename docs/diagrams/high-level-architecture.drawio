        </mxCell>

        <mxCell id="internet" value="&lt;b&gt;Internet / LAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;remote SSH clients,&lt;br&gt;scanners, services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="230" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="keys / frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="host" source="actor" target="system">
