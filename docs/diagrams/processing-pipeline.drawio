<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="processing-pipeline" name="Processing Pipeline">
    <mxGraphModel dx="1200" dy="1600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Processing Pipeline (C4 Level 2) - startup, event loop and the change pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="16" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Startup - main()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cli::parse (clap) -&amp;gt; Config::load (TOML, never fatal)&lt;br&gt;-&amp;gt; Theme::new -&amp;gt; pick backend: MockBackend (--demo) or UfwCli&lt;br&gt;--dump-state prints the parsed snapshot and exits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Watchdog short-circuit:&lt;br&gt;--internal-revert-after + --nonce runs watchdog::run_revert_helper and exits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. TerminalGuard::enter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;raw mode + alternate screen, panic hook installed;&lt;br&gt;signals TERM/INT/HUP set a shared quit flag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. Event loop (main.rs::run)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;terminal.draw(ui::draw) -&amp;gt; quit? -&amp;gt; take_escalation()&lt;br&gt;-&amp;gt; event::poll(200 ms) -&amp;gt; app.handle_key() -&amp;gt; app.tick()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="tick(): poll BlockMonitor rows (unless paused), drop an expired Watchdog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. App::handle_key dispatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;modal -&amp;gt; text input -&amp;gt; filter -&amp;gt; global keys (q ? X r u TAB)&lt;br&gt;-&amp;gt; per-tab handler (home, rules, wizard, test, activity, presets, settings)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Build a Change (core/command.rs)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;change_add / delete / edit / duplicate / move / comment /&lt;br&gt;policy / logging / enabled / reset -&amp;gt; Change { steps, inverse }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="PendingChange (core/lockout.rs) carries the kind, rule, draft and forced flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="590" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6. App::submit - safety gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;readonly / can_write? -&amp;gt; escalation request&lt;br&gt;lockout::check(session, pending, state): Block -&amp;gt; error modal&lt;br&gt;dry_run every step -&amp;gt; ConfirmModal (unless -y)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="&lt;b&gt;7. App::apply - execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Backend::run(step) for each argv -&amp;gt; on failure: error modal&lt;br&gt;journal.record + save -&amp;gt; refresh() -&amp;gt; status line&lt;br&gt;needs_watchdog() and via_ssh -&amp;gt; watchdog::spawn&lt;br&gt;then next_in_queue()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="460" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Detached helper process sleeps reconcile_seconds, then replays the inverse unless the .cancel marker appears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="850" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="&lt;b&gt;8. Backend layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UfwCli::run -&amp;gt; Command::new(ufw).args(argv), 10 s timeout,&lt;br&gt;LC_ALL=C, optional sudo -v escalation -&amp;gt; CmdOutput { argv, success, stdout, stderr }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="&lt;b&gt;9. App::refresh - read back and re-analyse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;parse_status_numbered + parse_status_verbose -&amp;gt; FirewallState&lt;br&gt;counters (nft) -&amp;gt; reanalyse: risk::assess_state, find_shadowed, presets::library&lt;br&gt;fallback read_unprivileged_state() when ufw hides rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="&lt;b&gt;10. Output - ui::draw&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;header (host, backend label, root state) + tabs + tab body&lt;br&gt;+ status line + watchdog countdown + footer hint from ui/keys.rs&lt;br&gt;+ modals (confirm with dry-run text, errors, warnings)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=8;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="1240" width="460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="back" value="loop: every frame re-reads App state; feedback appears here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;fontColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s10" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="1370" />
              <mxPoint x="20" y="1370" />
              <mxPoint x="20" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="key event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="change ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="submit(change, pending)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="run each step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="success -&amp;gt; refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="new snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s9" target="s10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="color" value="Colour key: blue = input and terminal setup, green = processing, orange = output and detached side effects." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1390" width="760" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
