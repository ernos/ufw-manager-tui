        <mxCell id="command" value="&lt;b&gt;command.rs&lt;/b&gt; - only place&lt;br&gt;that knows ufw syntax&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Change + change_add / delete /&lt;br&gt;edit / move / policy / reset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_core">
