        </mxCell>
        <mxCell id="corenote" value="Both highlighted modules are the safety-critical pair: command.rs builds argument vectors, lockout.rs refuses changes that would cut the SSH session." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="g_core">
          <mxGeometry x="20" y="680" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="g_back" value="backend/ - the Backend seam" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="330" height="560" as="geometry" />
        </mxCell>
        <mxCell id="trait" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;label, is_root, can_write, read_state,&lt;br&gt;app_profiles, listening, counters, run,&lt;br&gt;dry_run, ssh_port, ssh_session, lan, interfaces,&lt;br&gt;may_escalate, escalate, log_path&lt;br&gt;&lt;br&gt;returns core types: FirewallState, Rule,&lt;br&gt;Session, LanInfo, AppProfile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacingLeft=8;fontStyle=0;" vertex="1" parent="g_back">
          <mxGeometry x="20" y="40" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ufwcli" value="&lt;b&gt;ufw.rs - UfwCli&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;spawns ufw, sudo -v escalation,&lt;br&gt;10 s timeout, LC_ALL=C,&lt;br&gt;reads /etc/ufw/applications.d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_back">
          <mxGeometry x="20" y="160" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mock" value="&lt;b&gt;mock.rs - MockBackend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in-memory firewall from DEMO_STATUS;&lt;br&gt;used by --demo and every integration test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_back">
          <mxGeometry x="20" y="270" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="counters" value="&lt;b&gt;counters.rs - HitCounters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nft -j list ruleset, mapped by&lt;br&gt;position in ufw-user-input; all-or-nothing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_back">
          <mxGeometry x="20" y="370" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="&lt;b&gt;logs.rs - BlockMonitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;background thread tails ufw.log or&lt;br&gt;journalctl -k -f, aggregates rows;&lt;br&gt;started by App::bootstrap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_back">
          <mxGeometry x="20" y="460" width="290" height="70" as="geometry" />
        </mxCell>

        <mxCell id="g_probe" value="Probing and side effects" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#fff7e0;strokeColor=#d6b656;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="660" width="330" height="250" as="geometry" />
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;probe.rs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;detect_lan (ip route / addr),&lt;br&gt;interfaces, ssh_port from sshd_config,&lt;br&gt;SSH_CONNECTION -&amp;gt; Session;&lt;br&gt;used by UfwCli at construction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_probe">
