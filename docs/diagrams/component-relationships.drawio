        <mxCell id="watchdog" value="&lt;b&gt;watchdog.rs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Watchdog handle + WatchdogState;&lt;br&gt;spawn() detached helper, confirm(),&lt;br&gt;run_revert_helper();&lt;br&gt;spawned by App::apply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_probe">
          <mxGeometry x="20" y="135" width="290" height="90" as="geometry" />
