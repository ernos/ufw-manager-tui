<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="component-relationships" name="Component Relationships">
    <mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Component Relationships (C4 Level 3) - modules, the Backend seam and its two implementations" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="g_orch" value="Entry and orchestration" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="430" as="geometry" />
        </mxCell>
        <mxCell id="main" value="&lt;b&gt;main.rs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cli -&amp;gt; Config -&amp;gt; backend -&amp;gt; App&lt;br&gt;TerminalGuard, event loop, dump_state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_orch">
