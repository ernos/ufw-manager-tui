        <mxCell id="app" value="&lt;b&gt;app.rs&lt;/b&gt; - App state machine&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;handle_key, submit, apply, undo,&lt;br&gt;refresh, reanalyse, escalation, queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_orch">
