        <mxCell id="legend" value="Layering rule: ui/ never mutates state or touches the backend; core/ never spawns a process or reads a file; all OS access goes through the Backend trait." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
