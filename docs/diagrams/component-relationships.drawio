        </mxCell>
        <mxCell id="config" value="&lt;b&gt;config.rs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Config + RuleDefaults (TOML,&lt;br&gt;serde default + deny_unknown_fields)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="g_orch">
